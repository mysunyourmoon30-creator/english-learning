APP_IMAGE=ghcr.io/owner/englishmaster-ai@sha256:replace-with-64-hex-digest
POSTGRES_DB=englishmaster_staging
POSTGRES_USER=englishmaster
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080
ALLOWED_HOSTS=staging.example.com
REQUIRE_CONFIRMED_ACCOUNT=false

# StartupSecurityValidator refuses to start without these. The placeholders
# below are rejected on purpose, so a forgotten value fails at boot rather
# than publishing a legal contact nobody reads.
PROXY_ENABLED=true
TRUSTED_PROXY_NETWORK=SET_TO_INGRESS_CIDR
LEGAL_OPERATOR_NAME=SET_TO_REGISTERED_OPERATOR_NAME
PRIVACY_CONTACT_EMAIL=privacy@example.invalid
BACKUP_RETENTION_DAYS=30
TELEMETRY_RETENTION_DAYS=30

EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
OPENAI_API_KEY=
PRONUNCIATION_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERTING_ENABLED=false
ALERT_WEBHOOK_URL=
AUDIO_STORAGE_PROVIDER=FileSystem
AUDIO_BLOB_CONNECTION_STRING=
AUDIO_CREATE_CONTAINER_IF_MISSING=false
AUDIO_CDN_BASE_URL=
