@page "/dashboard"
@attribute [Authorize]
@inject CurrentUserService CurrentUser
@inject LearningService Learning

<PageTitle>Dashboard | EnglishMaster AI</PageTitle>

@if (Data is null)
{
    <div class="loading"><div class="spinner"></div></div>
}
else
{
    <div class="page-header">
        <div>
            <div class="eyebrow">PERSONAL LEARNING DASHBOARD</div>
            <h1>สวัสดี @Data.Profile.DisplayName</h1>
            <p>วันนี้เดินหน้าทีละช่วงสั้น ๆ ให้ครบทั้ง input, practice และ output</p>
        </div>
        <div>
            <span class="tag gold">🔥 @Data.Profile.CurrentStreak วันต่อเนื่อง</span>
        </div>
    </div>

    @if (!Data.Profile.OnboardingCompleted || !Data.Profile.PlacementCompleted)
    {
        <div class="callout mb-4">
            <p>
                <strong>ตั้งค่าระบบให้ครบเพื่อรับแผนส่วนตัว:</strong>
                @if (!Data.Profile.OnboardingCompleted)
                {
                    <a href="/onboarding">ตั้งเป้าหมาย</a>
                }
                else
                {
                    <a href="/placement">ทำ Placement Test</a>
                }
            </p>
        </div>
    }

    <section class="grid-4">
        <div class="surface stat-card"><small>ระดับปัจจุบัน</small><strong>@Data.Profile.CurrentCefr</strong><span>เป้าหมาย @Data.Profile.TargetCefr</span></div>
        <div class="surface stat-card"><small>ความคืบหน้ารวม</small><strong>@Data.OverallProgress%</strong><div class="progress"><div class="progress-bar" style="@($"width:{Data.OverallProgress}%")"></div></div></div>
        <div class="surface stat-card"><small>บทเรียนที่ผ่าน</small><strong>@Data.CompletedLessons/@Data.TotalLessons</strong><span>เกณฑ์ผ่าน quiz ≥ 80%</span></div>
        <div class="surface stat-card"><small>ถึงเวลาทบทวน</small><strong>@Data.DueReviews</strong><a href="/review" class="small text-decoration-none">เปิด SRS queue →</a></div>
    </section>

    <div class="grid-2 mt-4">
        <section class="surface surface-pad">
            <div class="section-title mt-0">
                <div><div class="eyebrow">TODAY · @Data.Profile.DailyMinutes MINUTES</div><h2>แผนเรียนวันนี้</h2></div>
            </div>
            <ul class="list-clean">
                @foreach (var task in Data.DailyPlan)
                {
                    <li>
                        <a href="@task.Url" class="d-flex align-items-center gap-3 py-3 text-decoration-none text-reset">
                            <span class="task-icon @task.Kind">@TaskIcon(task.Kind)</span>
                            <span class="flex-grow-1"><strong class="d-block">@task.Title</strong><small class="text-secondary">@task.Detail</small></span>
                            <span class="tag">@task.Minutes นาที</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
        <section class="surface surface-pad">
            <div class="eyebrow">FOCUS AREAS</div>
            <h2>จุดที่ควรพัฒนาก่อน</h2>
            <p class="text-secondary small">เรียงจากผล Placement Test ล่าสุด และจะปรับเมื่อมีข้อมูลใหม่</p>
            <ol class="focus-list">
                @for (var i = 0; i < Data.WeakAreas.Count; i++)
                {
                    <li><span>@(i + 1)</span><strong>@Data.WeakAreas[i]</strong></li>
                }
            </ol>
            <a class="btn btn-outline-primary w-100 mt-3" href="/placement">ทำ Placement ใหม่</a>
        </section>
    </div>

    <div class="grid-2 mt-4">
        <section class="surface surface-pad">
            <div class="eyebrow">LAST 7 DAYS</div>
            <div class="d-flex justify-content-between align-items-end gap-3">
                <div>
                    <h2 class="mb-1">@Data.WeeklyProgress.Minutes นาที</h2>
                    <small class="text-secondary">
                        @Data.WeeklyProgress.ActivityCount กิจกรรม · @Data.WeeklyProgress.Points XP
                    </small>
                </div>
                <span class="tag">@Data.WeeklyProgress.LessonsCompleted บทเรียน</span>
            </div>
            @{
                // Scale against the daily goal, or the week's best day when that
                // is higher. A fixed multiplier clipped every day past ~33
                // minutes, so a learner meeting a 60 minute goal saw seven
                // identical full-height bars and learned nothing from the chart.
                var barScale = Math.Max(
                    Math.Max(1, Data.Profile.DailyMinutes),
                    Data.WeeklyProgress.Days.Count == 0
                        ? 0
                        : Data.WeeklyProgress.Days.Max(x => x.Minutes));
            }
            <div class="weekly-bars mt-3" aria-label="กิจกรรมการเรียนเจ็ดวันล่าสุด">
                @foreach (var day in Data.WeeklyProgress.Days)
                {
                    var height = day.Minutes <= 0
                        ? 6
                        : (int)Math.Round(Math.Max(10d, 100d * day.Minutes / barScale));
                    <div title="@($"{day.Date:dd MMM}: {day.Minutes} นาที (เป้าหมาย {Data.Profile.DailyMinutes} นาที)")">
                        <span style="@($"height:{height}px")"></span>
                        <small>@day.Date.ToString("ddd")</small>
                    </div>
                }
            </div>
        </section>
        <section class="surface surface-pad">
            <div class="eyebrow">ACHIEVEMENTS</div>
            <h2>ความสำเร็จล่าสุด</h2>
            @if (Data.Achievements.Count == 0)
            {
                <p class="text-secondary small">ทำกิจกรรมแรกเพื่อปลดล็อก badge</p>
            }
            else
            {
                <div class="achievement-list">
                    @foreach (var achievement in Data.Achievements.Take(4))
                    {
                        <div>
                            <span aria-hidden="true">★</span>
                            <p><strong>@achievement.Title</strong><small>@achievement.Description</small></p>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <div class="section-title">
        <h2>เรียนต่อจากจุดนี้</h2>
        <a href="/roadmap">ดู Roadmap ทั้งหมด →</a>
    </div>
    <section class="module-grid">
        @foreach (var module in Data.ContinueModules)
        {
            <a class="surface module-card" href="@(module.FirstLessonSlug is null ? "/learn" : $"/lessons/{module.FirstLessonSlug}")">
                <div class="module-code"><span>@module.Code · @module.CefrLevel</span><span class="tag">@module.ProgressPercent%</span></div>
                <h3>@module.Title</h3>
                <p>@module.TitleThai<br />@module.Summary</p>
                <div class="progress"><div class="progress-bar" style="@($"width:{module.ProgressPercent}%")"></div></div>
                <div class="module-foot"><span>@module.CompletedLessons/@module.TotalLessons บท</span><span>เรียนต่อ →</span></div>
            </a>
        }
    </section>
}

@code {
    private DashboardData? Data;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetRequiredUserIdAsync();
        Data = await Learning.GetDashboardAsync(userId);
    }

    private static string TaskIcon(string kind) => kind switch
    {
        "review" => "↻",
        "listening" => "◖",
        "ai" => "✦",
        _ => "A"
    };
}
