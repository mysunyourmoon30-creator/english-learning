@page "/practice/speaking"
@attribute [Authorize]
@inject IJSRuntime JS
@inject SpeakingAnalysisService Speaking
@inject PronunciationAssessmentService Pronunciation
@inject CurrentUserService CurrentUser

<PageTitle>Speaking Practice | EnglishMaster AI</PageTitle>

<div class="page-header">
    <div>
        <div class="eyebrow">SPEAKING PRACTICE</div>
        <h1>อธิบายให้ชัด ไม่ต้องเลียนสำเนียง</h1>
        <p>ประเมิน fluency, grammar, vocabulary, relevance และ organization โดยไม่หักคะแนนเพียงเพราะสำเนียงต่างจากเจ้าของภาษา</p>
    </div>
    <span class="tag gold">@(_pronunciationMode ? "อ่านตาม 20–30 วินาที" : "พูดอิสระ 60–90 วินาที")</span>
</div>

<div class="split-layout">
    <section class="surface surface-pad">
        <div class="eyebrow">TODAY'S PROMPT</div>
        <div class="d-flex gap-2 flex-wrap my-3">
            <button class="btn @(!_pronunciationMode ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetMode(false)">พูดอิสระ</button>
            <button class="btn @(_pronunciationMode ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetMode(true)">Pronunciation จากเสียง</button>
        </div>
        <h2>@CurrentPrompt</h2>
        @if (_pronunciationMode)
        {
            <div class="callout">
                <p><strong>Reference:</strong> @ReferenceText</p>
                <small>
                    @(Pronunciation.IsConfigured
                        ? "ระบบจะประเมิน accuracy, fluency, completeness และ prosody จาก acoustic signal"
                        : "ยังไม่ได้ตั้ง Azure Speech key ระบบจะให้ transcript feedback แต่จะไม่สร้างคะแนน pronunciation ปลอม")
                </small>
            </div>
        }
        else
        {
            <div class="speaking-framework">
                <div><span>P</span><strong>Point</strong><small>I prefer / The main idea is…</small></div>
                <div><span>R</span><strong>Reason</strong><small>because…</small></div>
                <div><span>E</span><strong>Example</strong><small>For example…</small></div>
                <div><span>R</span><strong>Result</strong><small>As a result…</small></div>
            </div>
        }
        <div class="record-stage @(_recording ? "is-recording" : "")">
            <div class="record-dot"></div>
            <strong>@StatusText</strong>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="text-danger small">@_error</p>
            }
            <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
                @if (!_recording)
                {
                    <button class="btn btn-primary" disabled="@_analyzing" @onclick="StartAsync">
                        @(_hasRecording ? "อัดใหม่" : "เริ่มบันทึก")
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-primary" @onclick="StopAsync">หยุดบันทึก</button>
                }
            </div>
            <audio id="recording-preview" class="w-100 mt-3" controls hidden></audio>
        </div>

        @if (_hasRecording)
        {
            <div class="privacy-box mt-3">
                <label>
                    <input type="checkbox" @bind="_consent" />
                    ยินยอมให้ประมวลผลเสียงเพื่อสร้าง transcript และ feedback
                </label>
                <small>ไฟล์เสียงประมวลผลในหน่วยความจำและไม่ถูกบันทึกลงฐานข้อมูล ระบบเก็บเฉพาะ transcript กับผลประเมิน</small>
                <button class="btn btn-primary mt-3" disabled="@(!_consent || _analyzing)" @onclick="AnalyzeAsync">
                    @(_analyzing ? "กำลังวิเคราะห์…" : "วิเคราะห์การพูด")
                </button>
            </div>
        }
    </section>
    <aside class="surface surface-pad sticky-panel">
        @if (_feedback is null)
        {
            <div class="eyebrow">SELF-CHECK</div>
            <h2>ฟังเสียงตัวเองแล้วตรวจ</h2>
            <label class="check-item"><input type="checkbox" /> มี Point ชัดเจน</label>
            <label class="check-item"><input type="checkbox" /> ให้เหตุผลด้วย because</label>
            <label class="check-item"><input type="checkbox" /> มีตัวอย่างจริง</label>
            <label class="check-item"><input type="checkbox" /> สรุปผลด้วย as a result</label>
            <label class="check-item"><input type="checkbox" /> เสียงท้ายคำสำคัญชัดเจน</label>
            <div class="callout mt-3">
                <p>Chrome/Edge สามารถสร้าง browser transcript เป็น fallback ได้ หากกำหนด AI key ระบบจะใช้ server transcription แทน</p>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="feedback-score"><strong>@_feedback.Score</strong><span>/ 100</span></div>
                <span class="tag">@_feedback.EvaluationMode</span>
            </div>
            <div class="metric-row">
                <span>@_feedback.WordCount words</span>
                <span>@_feedback.WordsPerMinute wpm</span>
                <span>@_feedback.FillerWordCount fillers</span>
            </div>
            <div class="rubric-grid">
                <span>Fluency<strong>@_feedback.Rubric.Fluency/20</strong></span>
                <span>Grammar<strong>@_feedback.Rubric.Grammar/20</strong></span>
                <span>Vocabulary<strong>@_feedback.Rubric.Vocabulary/20</strong></span>
                <span>Relevance<strong>@_feedback.Rubric.Relevance/20</strong></span>
                <span>Organization<strong>@_feedback.Rubric.Organization/20</strong></span>
            </div>
            <p class="small text-secondary">@_feedback.Notice</p>
            @if (_feedback.Pronunciation is not null)
            {
                <h3>Acoustic pronunciation assessment</h3>
                <div class="rubric-grid acoustic">
                    <span>Pronunciation<strong>@_feedback.Pronunciation.PronunciationScore.ToString("0.0")</strong></span>
                    <span>Accuracy<strong>@_feedback.Pronunciation.AccuracyScore.ToString("0.0")</strong></span>
                    <span>Fluency<strong>@_feedback.Pronunciation.FluencyScore.ToString("0.0")</strong></span>
                    <span>Completeness<strong>@_feedback.Pronunciation.CompletenessScore.ToString("0.0")</strong></span>
                    <span>Prosody<strong>@_feedback.Pronunciation.ProsodyScore.ToString("0.0")</strong></span>
                </div>
                <p class="small text-secondary">
                    @_feedback.Pronunciation.Provider — @_feedback.Pronunciation.Notice
                </p>
            }
            <h3 class="text-success">จุดที่ทำได้ดี</h3>
            <ul class="small lh-lg">@foreach (var item in _feedback.Strengths) { <li>@item</li> }</ul>
            <h3 class="text-warning">ลองปรับรอบถัดไป</h3>
            <ul class="small lh-lg">@foreach (var item in _feedback.Suggestions) { <li>@item</li> }</ul>
            <h3>Transcript</h3>
            <div class="transcript-box">@(_feedback.Transcript.Length == 0 ? "ไม่พบ transcript" : _feedback.Transcript)</div>
        }
    </aside>
</div>

@code {
    private const string FreeSpeakingPrompt = "Explain why a team might use RAG in an AI application.";
    private const string ReferenceText = "Relevant chunks are retrieved, ranked, and sent to the model as grounded context.";
    private bool _pronunciationMode;
    private bool _recording;
    private bool _hasRecording;
    private bool _consent;
    private bool _analyzing;
    private string? _error;
    private RecordingMetadata? _recordingMetadata;
    private SpeakingFeedback? _feedback;
    private string CurrentPrompt => _pronunciationMode
        ? "Read the reference sentence aloud as clearly and naturally as you can."
        : FreeSpeakingPrompt;

    private string StatusText => _recording
        ? "กำลังบันทึกเสียง…"
        : _analyzing
            ? "กำลังถอดเสียงและวิเคราะห์…"
            : _hasRecording
                ? $"บันทึกแล้ว {_recordingMetadata?.DurationSeconds ?? 0} วินาที — ฟังหรือส่งวิเคราะห์ได้"
                : "พร้อมเมื่อคุณพร้อม";

    private async Task StartAsync()
    {
        try
        {
            _error = null;
            _feedback = null;
            _consent = false;
            await JS.InvokeVoidAsync("englishMaster.startRecording");
            _recording = true;
        }
        catch (JSException)
        {
            _error = "ไม่สามารถใช้ไมโครโฟนได้ กรุณาตรวจสิทธิ์ของ browser";
        }
    }

    private void SetMode(bool pronunciationMode)
    {
        if (_recording || _analyzing)
        {
            return;
        }

        _pronunciationMode = pronunciationMode;
        _feedback = null;
        _hasRecording = false;
        _recordingMetadata = null;
        _error = null;
    }

    private async Task StopAsync()
    {
        try
        {
            _recordingMetadata = await JS.InvokeAsync<RecordingMetadata>(
                "englishMaster.stopRecording",
                "recording-preview");
            _recording = false;
            _hasRecording = _recordingMetadata.Size > 0;
        }
        catch (JSException)
        {
            _recording = false;
            _error = "หยุดบันทึกไม่สำเร็จ กรุณาลองใหม่";
        }
    }

    private async Task AnalyzeAsync()
    {
        if (_recordingMetadata is null)
        {
            return;
        }

        _analyzing = true;
        _error = null;
        IJSStreamReference? audioReference = null;
        Stream? audioStream = null;
        try
        {
            audioReference = await JS.InvokeAsync<IJSStreamReference>(
                "englishMaster.getRecordingBlob");
            audioStream = await audioReference.OpenReadStreamAsync(
                maxAllowedSize: 10 * 1024 * 1024);
            _feedback = await Speaking.EvaluateAsync(
                await CurrentUser.GetRequiredUserIdAsync(),
                CurrentPrompt,
                audioStream,
                "speaking.wav",
                _recordingMetadata.Type,
                _recordingMetadata.DurationSeconds,
                _recordingMetadata.Transcript,
                _pronunciationMode ? ReferenceText : string.Empty);
        }
        catch (Exception)
        {
            _error = "วิเคราะห์เสียงไม่สำเร็จ กรุณาตรวจขนาดไฟล์หรือทดลองอัดใหม่";
        }
        finally
        {
            if (audioStream is not null)
            {
                await audioStream.DisposeAsync();
            }
            if (audioReference is not null)
            {
                await audioReference.DisposeAsync();
            }
            _analyzing = false;
        }
    }

    private sealed class RecordingMetadata
    {
        public long Size { get; set; }
        public string Type { get; set; } = "audio/wav";
        public int DurationSeconds { get; set; }
        public string Transcript { get; set; } = string.Empty;
    }
}
