@page "/lessons/{Slug}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject LearningService Learning
@inject CurrentUserService CurrentUser
@inject IJSRuntime JS

<PageTitle>@(_lesson?.Title ?? "Lesson") | EnglishMaster AI</PageTitle>

@if (_loading)
{
    <div class="loading"><div class="spinner"></div></div>
}
else if (_lesson is null)
{
    <div class="empty-state"><div class="empty-icon">!</div><h1>ไม่พบบทเรียน</h1><a href="/learn">กลับ English Core</a></div>
}
else
{
    <div class="lesson-head">
        <div>
            <div class="eyebrow">@_lesson.Module.Code · @_lesson.Module.CefrLevel · VERSION @_lesson.Version</div>
            <h1>@_lesson.Title</h1>
            <p>@_lesson.Objective</p>
        </div>
        <div class="lesson-meta">
            <span class="tag">@_lesson.EstimatedMinutes นาที</span>
            <span class="tag gold">Quiz ≥ 80%</span>
        </div>
    </div>

    <div class="split-layout">
        <main>
            <section id="concept" class="surface lesson-section">
                <h2><span class="step-number">1</span> Concept Preview</h2>
                <p class="lesson-copy">@_lesson.ThaiExplanation</p>
                <div class="objective-box"><strong>Can-do outcome</strong><span>@_lesson.Objective</span></div>
            </section>

            <section id="vocabulary" class="surface lesson-section">
                <h2><span class="step-number">2</span> Key Vocabulary</h2>
                <div class="table-responsive">
                    <table class="word-table">
                        <thead><tr><th>Word</th><th>Meaning & form</th><th>Chunk</th><th>Example</th><th>Audio</th></tr></thead>
                        <tbody>
                        @foreach (var item in _lesson.Vocabulary)
                        {
                            <tr>
                                <td><strong>@item.Word</strong><br /><small>@item.Pronunciation</small></td>
                                <td>@item.ThaiMeaning<br /><small>@item.WordForm</small></td>
                                <td>@item.Collocation</td>
                                <td>@item.ExampleSentence</td>
                                <td><button class="audio-button" title="ฟังการออกเสียง" @onclick="() => SpeakAsync(item.Word, 0.8)">▶</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="grammar" class="surface lesson-section">
                <h2><span class="step-number">3</span> Grammar in Context</h2>
                <p class="lesson-copy">@_lesson.GrammarFocus</p>
            </section>

            <section id="reading" class="surface lesson-section">
                <div class="d-flex justify-content-between gap-2 align-items-center">
                    <h2><span class="step-number">4</span> Reading</h2>
                    <span class="tag blue">English Only</span>
                </div>
                <blockquote class="reading-copy">@_lesson.ReadingContent</blockquote>
            </section>

            <section id="listening" class="surface lesson-section">
                <h2><span class="step-number">5</span> Listening & Shadowing</h2>
                <div class="audio-player">
                    <button class="play-button" @onclick="() => SpeakAsync(_lesson.ListeningTranscript, _speed)">▶</button>
                    <div class="flex-grow-1"><strong>Lesson audio</strong><small>ฟังก่อนเปิด transcript แล้วพูดตาม</small></div>
                    <select class="form-select speed-select" @bind="_speed">
                        <option value="0.7">0.7×</option><option value="0.85">0.85×</option><option value="1">1×</option><option value="1.15">1.15×</option>
                    </select>
                </div>
                <button class="btn btn-ghost btn-sm mt-3" @onclick="() => _showTranscript = !_showTranscript">
                    @(_showTranscript ? "ซ่อน Transcript" : "เปิด Transcript")
                </button>
                @if (_showTranscript)
                {
                    <div class="transcript mt-2">@_lesson.ListeningTranscript</div>
                }
            </section>

            <section id="output" class="surface lesson-section">
                <h2><span class="step-number">6</span> Output Practice</h2>
                <div class="grid-2">
                    <div class="practice-card"><span>🎙</span><div><strong>Speaking</strong><p>@_lesson.SpeakingPrompt</p><a href="/practice/speaking">เปิด Speaking Lab →</a></div></div>
                    <div class="practice-card"><span>✎</span><div><strong>Writing</strong><p>@_lesson.WritingPrompt</p><a href="/practice/writing">เปิด Writing Lab →</a></div></div>
                </div>
            </section>

            <section id="quiz" class="surface lesson-section">
                <h2><span class="step-number">7</span> Knowledge Quiz</h2>
                @foreach (var question in _lesson.Questions.OrderBy(x => x.SortOrder))
                {
                    var options = Options(question);
                    <div class="question-card">
                        <div class="eyebrow">@question.Skill</div>
                        <h3>@question.Prompt</h3>
                        <div class="quiz-options">
                            @for (var index = 0; index < options.Count; index++)
                            {
                                var captured = index;
                                <button type="button"
                                        class="quiz-option @QuizOptionClass(question.Id, captured)"
                                        disabled="@(_quizResult is not null)"
                                        @onclick="() => _answers[question.Id] = captured">
                                    <span>@((char)('A' + captured)).</span> @options[captured]
                                </button>
                            }
                        </div>
                        @if (_quizResult is not null)
                        {
                            <p class="small mt-2 @(_quizResult.Correctness[question.Id] ? "text-success" : "text-danger")">
                                @(_quizResult.Correctness[question.Id] ? "ถูกต้อง — " : "ยังไม่ถูก — ") @_quizResult.Explanations[question.Id]
                            </p>
                        }
                    </div>
                }
                @if (_quizResult is null)
                {
                    <button class="btn btn-primary" disabled="@(_answers.Count != _lesson.Questions.Count || _submitting)" @onclick="SubmitQuizAsync">
                        @(_submitting ? "กำลังตรวจ…" : "ส่งคำตอบ")
                    </button>
                }
                else
                {
                    <div class="quiz-result @(_quizResult.Passed ? "passed" : "retry")">
                        <strong>@_quizResult.Score%</strong>
                        <div>
                            <h3>@(_quizResult.Passed ? "ผ่านบทเรียนแล้ว" : "ทบทวนอีกครั้งแล้วลองใหม่")</h3>
                            <p>@_quizResult.Correct/@_quizResult.Total ข้อ · คำศัพท์ในบทถูกเพิ่มเข้า Review Queue แล้ว</p>
                        </div>
                        @if (_quizResult.Passed)
                        {
                            <a class="btn btn-primary" href="/roadmap">ไปบทถัดไป →</a>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary" @onclick="RetryQuiz">ลองใหม่</button>
                        }
                    </div>
                }
            </section>
        </main>
        <aside class="surface surface-pad sticky-panel lesson-nav">
            <div class="eyebrow">LESSON MAP</div>
            <a href="#concept">01 Concept Preview</a>
            <a href="#vocabulary">02 Vocabulary</a>
            <a href="#grammar">03 Grammar</a>
            <a href="#reading">04 Reading</a>
            <a href="#listening">05 Listening</a>
            <a href="#output">06 Speaking & Writing</a>
            <a href="#quiz">07 Quiz</a>
            <div class="callout mt-3"><p>ทุกข้อผิดจะถูกส่งไปทบทวน ไม่มีคำผิดใดหายไปหลังจบบท</p></div>
        </aside>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private Lesson? _lesson;
    private bool _loading = true;
    private bool _showTranscript;
    private bool _submitting;
    private double _speed = 0.85;
    private readonly Dictionary<Guid, int> _answers = [];
    private QuizResult? _quizResult;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _lesson = await Learning.GetLessonAsync(Slug);
        _answers.Clear();
        _quizResult = null;
        _loading = false;
    }

    private static IReadOnlyList<string> Options(AssessmentQuestion question) =>
        JsonSerializer.Deserialize<List<string>>(question.OptionsJson) ?? [];

    private Task SpeakAsync(string text, double speed) =>
        JS.InvokeVoidAsync("englishMaster.speak", text, speed).AsTask();

    private string QuizOptionClass(Guid questionId, int index)
    {
        if (_quizResult is not null)
        {
            return _quizResult.Correctness[questionId]
                ? (_answers.GetValueOrDefault(questionId) == index ? "correct" : "")
                : (_answers.GetValueOrDefault(questionId) == index ? "incorrect" : "");
        }
        return _answers.GetValueOrDefault(questionId, -1) == index ? "selected" : "";
    }

    private async Task SubmitQuizAsync()
    {
        if (_lesson is null) return;
        _submitting = true;
        _quizResult = await Learning.SubmitLessonQuizAsync(
            await CurrentUser.GetRequiredUserIdAsync(), _lesson.Id, _answers);
        _submitting = false;
    }

    private void RetryQuiz()
    {
        _answers.Clear();
        _quizResult = null;
    }
}
