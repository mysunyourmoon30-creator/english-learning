@page "/Error"
@using System.Diagnostics

<PageTitle>เกิดข้อผิดพลาด | EnglishMaster AI</PageTitle>

<div class="empty-state">
    <div class="empty-icon">!</div>
    <h1>ระบบดำเนินการไม่สำเร็จ</h1>
    <p>กรุณาลองอีกครั้ง หากปัญหายังเกิดขึ้นให้แจ้ง Request ID ด้านล่างแก่ผู้ดูแลระบบ</p>

    @if (ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@RequestId</code></p>
    }
    <a class="btn btn-primary" href="/">กลับหน้าหลัก</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
