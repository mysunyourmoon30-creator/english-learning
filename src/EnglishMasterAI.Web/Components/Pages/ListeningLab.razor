@page "/practice/listening"
@attribute [Authorize]
@inject IJSRuntime JS
@inject ReferenceAudioService ReferenceAudio
@inject CurrentUserService CurrentUser

<PageTitle>Listening Lab | EnglishMaster AI</PageTitle>

<div class="page-header">
    <div>
        <div class="eyebrow">LISTENING LAB</div>
        <h1>ฟัง → ตรวจ → พูดตาม → ฟังซ้ำ</h1>
        <p>ทำตามลำดับโดยยังไม่เปิด transcript ในรอบแรก</p>
    </div>
    <span class="tag blue">B1 · Technical English</span>
</div>

<div class="split-layout">
    <section class="surface surface-pad">
        <div class="audio-stage">
            <span class="wave" aria-hidden="true">▂▄▆█▆▄▂ ▃▇▅▂▄▆▃</span>
            <h2>RAG workflow · 34 seconds</h2>
            <p>ปรับความเร็วแล้วกดเล่น ฟังเนื้อหาให้ครบก่อนตอบ</p>
            <button class="play-main" disabled="@_loadingAudio" @onclick="PlayAsync">▶</button>
            @if (_audioDataUrl is not null)
            {
                <audio class="w-100 mt-2" controls autoplay src="@_audioDataUrl"></audio>
                <small class="d-block text-warning mt-2">@_audioDisclosure</small>
            }
            @if (!string.IsNullOrWhiteSpace(_audioError))
            {
                <small class="d-block text-warning mt-2">@_audioError</small>
            }
            <div class="speed-row">
                <label for="speed">Speed @_speed.ToString("0.00")×</label>
                <input id="speed" type="range" min="0.6" max="1.2" step="0.05" @bind="_speed" />
            </div>
        </div>

        <div class="question-card mt-4">
            <div class="eyebrow">CHECK UNDERSTANDING</div>
            <h3>What happens immediately before the context is sent to the model?</h3>
            <div class="quiz-options">
                @foreach (var option in _options)
                {
                    <button class="quiz-option @(_selected == option ? "selected" : "")" @onclick="() => _selected = option">@option</button>
                }
            </div>
            @if (_selected is not null)
            {
                <div class="alert @(_selected == _options[1] ? "alert-success" : "alert-warning") mt-3">
                    @(_selected == _options[1] ? "Correct — the retrieved chunks are ranked first." : "Listen for the sequence words: first, next, then, finally.")
                </div>
            }
        </div>
    </section>
    <aside class="surface surface-pad sticky-panel">
        <div class="eyebrow">TRANSCRIPT & SHADOWING</div>
        <button class="btn btn-outline-primary w-100" @onclick="() => _showTranscript = !_showTranscript">
            @(_showTranscript ? "ซ่อน Transcript" : "เปิด Transcript")
        </button>
        @if (_showTranscript)
        {
            <p class="transcript mt-3">@_transcript</p>
            <hr />
            <h3>Shadowing loop</h3>
            <ol class="small text-secondary lh-lg">
                <li>ฟังหนึ่งประโยค</li>
                <li>หยุดและพูดตาม</li>
                <li>บันทึก chunks ที่ไม่คุ้น</li>
                <li>ฟังทั้งย่อหน้าอีกครั้ง</li>
            </ol>
        }
        else
        {
            <p class="text-secondary small mt-3">ตอบคำถามก่อน แล้วจึงเปิดข้อความเพื่อตรวจ chunks ที่ได้ยินไม่ชัด</p>
        }
    </aside>
</div>

<style>
    .audio-stage{text-align:center;padding:2rem 1rem;background:#153f3b;color:white;border-radius:1rem}.audio-stage p{color:#b9d0ca}.wave{display:block;color:#efbd5d;font:800 1.7rem/1 Manrope;letter-spacing:.2rem;margin-bottom:1rem}
    .play-main{width:4rem;height:4rem;border:0;border-radius:50%;background:#e4a93e;color:#17332f;font-size:1.2rem;margin:1rem}
    .speed-row{display:flex;justify-content:center;align-items:center;gap:1rem}.speed-row input{accent-color:#e4a93e}
    .transcript{line-height:1.9;padding:1rem;background:#f6f8f5;border-radius:.7rem}
</style>

@code {
    private const string _transcript = "First, the user query is converted into an embedding. Next, relevant chunks are retrieved from the knowledge source and ranked. Then, the selected context is sent to the language model. Finally, the model generates an answer with source references.";
    private readonly string[] _options = ["The answer is deleted.", "The retrieved chunks are ranked.", "The user closes the application.", "The model is deployed."];
    private string? _selected;
    private bool _showTranscript;
    private bool _loadingAudio;
    private string? _audioDataUrl;
    private string? _audioDisclosure;
    private string? _audioError;
    private double _speed = 0.85;

    private async Task PlayAsync()
    {
        _audioError = null;
        if (!ReferenceAudio.IsConfigured)
        {
            _audioError = "กำลังใช้เสียงสังเคราะห์ของ browser — ตั้ง AI__ApiKey เพื่อสร้างและแคช reference audio คุณภาพสูง";
            await JS.InvokeVoidAsync("englishMaster.speak", _transcript, _speed);
            return;
        }

        _loadingAudio = true;
        try
        {
            var audio = await ReferenceAudio.GetOrCreateAsync(
                await CurrentUser.GetRequiredUserIdAsync(),
                _transcript);
            _audioDataUrl = $"data:{audio.ContentType};base64,{Convert.ToBase64String(audio.Bytes)}";
            _audioDisclosure = audio.Disclosure;
        }
        catch (Exception)
        {
            _audioError = "สร้าง reference audio ไม่สำเร็จ จึงใช้เสียงของ browser แทน";
            await JS.InvokeVoidAsync("englishMaster.speak", _transcript, _speed);
        }
        finally
        {
            _loadingAudio = false;
        }
    }
}
