@inject AssessmentService Assessment
@inject CurrentUserService CurrentUser
@inject ToeicAudioService ToeicAudio
@inject ToeicMediaCatalog ToeicMedia
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_loading)
{
    <div class="loading"><div class="spinner"></div></div>
}
else if (_result is not null)
{
    <section class="result-hero surface">
        <div class="score-ring"><strong>@_result.OverallCefr</strong><small>CEFR</small></div>
        <div>
            <div class="eyebrow">ASSESSMENT COMPLETE</div>
            <h1>เห็นภาพจุดเริ่มต้นแล้ว</h1>
            <p>ตอบถูก @_result.CorrectAnswers จาก @_result.TotalQuestions ข้อ · TOEIC โดยประมาณ @_result.EstimatedToeicScore</p>
        </div>
    </section>
    <div class="grid-2 mt-4">
        <section class="surface surface-pad">
            <h2>คะแนนรายทักษะ</h2>
            @foreach (var skill in _result.SkillScores.OrderBy(x => x.Key))
            {
                <div class="skill-row">
                    <div><strong>@skill.Key</strong><span>@skill.Value%</span></div>
                    <div class="progress"><div class="progress-bar" style="@($"width:{skill.Value}%")"></div></div>
                </div>
            }
        </section>
        <section class="surface surface-pad">
            <h2>ลำดับที่ควรพัฒนาก่อน</h2>
            <ol class="priority-list">
                @foreach (var priority in _result.Priorities)
                {
                    <li>@priority</li>
                }
            </ol>
            <a class="btn btn-primary w-100 mt-3" href="@CompletionUrl">@CompletionLabel →</a>
        </section>
    </div>
}
else if (_questions.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">?</div><h2>ยังไม่มีข้อสอบที่เปิดใช้</h2></div>
}
else
{
    <div class="assessment-top">
        <div>
            <span class="tag">@(_current + 1) / @_questions.Count</span>
            @if (CurrentQuestion.ToeicPart is not null)
            {
                <span class="tag gold ms-1">Part @CurrentQuestion.ToeicPart</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (TimeLimitMinutes > 0)
            {
                <span class="timer @(_remainingSeconds <= 300 ? "ending" : "")">@TimerText</span>
            }
            <span class="text-secondary small">@_answers.Count ข้อตอบแล้ว</span>
        </div>
    </div>
    <div class="progress mb-3"><div class="progress-bar" style="@($"width:{(_current + 1) * 100 / _questions.Count}%")"></div></div>

    <section class="surface question-focus">
        <div class="eyebrow">@CurrentQuestion.Skill</div>
        @if (IsListeningQuestion)
        {
            @if (ToeicMedia.GetApprovedPartOneImageUrl(CurrentQuestion) is { } imageUrl)
            {
                <img class="toeic-part-one-image mb-3"
                     src="@imageUrl"
                     alt="Licensed photograph for TOEIC Part 1 practice item" />
            }
            <div class="listening-audio">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@_loadingAudio"
                        @onclick="PlayListeningAudioAsync">
                    @(_loadingAudio ? "Preparing audio…" : "▶ Play TOEIC audio")
                </button>
                @if (_audioDataUrl is not null)
                {
                    <audio class="w-100 mt-3" controls autoplay src="@_audioDataUrl"></audio>
                    <small class="d-block text-secondary mt-2">@_audioDisclosure</small>
                }
                @if (!string.IsNullOrWhiteSpace(_audioError))
                {
                    <div class="alert alert-warning mt-3">@_audioError</div>
                }
            </div>
        }
        @if (!IsListeningQuestion && !string.IsNullOrWhiteSpace(CurrentQuestion.SupportingText))
        {
            <blockquote>@CurrentQuestion.SupportingText</blockquote>
        }
        <h2>@DisplayPrompt</h2>
        <div class="quiz-options">
            @for (var optionIndex = 0; optionIndex < CurrentQuestion.Options.Count; optionIndex++)
            {
                var capturedIndex = optionIndex;
                <button type="button"
                        class="quiz-option @SelectedClass(capturedIndex)"
                        @onclick="() => Select(capturedIndex)">
                    <span class="option-letter">@((char)('A' + capturedIndex))</span>
                    <span>@OptionLabel(capturedIndex)</span>
                </button>
            }
        </div>
    </section>

    <div class="assessment-actions">
        <button class="btn btn-ghost" disabled="@(_current == 0)" @onclick="Previous">← ย้อนกลับ</button>
        @if (_current < _questions.Count - 1)
        {
            <button class="btn btn-primary" disabled="@(!AllowSkipping && !_answers.ContainsKey(CurrentQuestion.Id))" @onclick="Next">ข้อต่อไป →</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@(!AllowSkipping && _answers.Count != _questions.Count || _submitting)" @onclick="SubmitAsync">
                @(_submitting ? "กำลังวิเคราะห์…" : "ส่งคำตอบและวิเคราะห์ผล")
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public AssessmentKind Kind { get; set; }
    [Parameter] public string CompletionUrl { get; set; } = "/dashboard";
    [Parameter] public string CompletionLabel { get; set; } = "เปิด Roadmap ส่วนตัว";
    [Parameter] public int TimeLimitMinutes { get; set; }
    [Parameter] public bool AllowSkipping { get; set; }

    private IReadOnlyList<QuestionPrompt> _questions = [];
    private readonly Dictionary<Guid, int> _answers = [];
    private AssessmentResult? _result;
    private int _current;
    private bool _loading = true;
    private bool _submitting;
    private bool _loadingAudio;
    private Guid? _audioQuestionId;
    private string? _audioDataUrl;
    private string? _audioDisclosure;
    private string? _audioError;
    private DateTimeOffset _startedAt;
    private int _remainingSeconds;
    private CancellationTokenSource? _timerCancellation;
    private QuestionPrompt CurrentQuestion => _questions[_current];
    private bool IsListeningQuestion =>
        ToeicListeningPresentation.IsListening(CurrentQuestion);
    private string DisplayPrompt => IsListeningQuestion
        ? ToeicListeningPresentation.DisplayPrompt(CurrentQuestion)
        : CurrentQuestion.Prompt;
    private string TimerText => TimeSpan.FromSeconds(Math.Max(0, _remainingSeconds)).ToString(@"hh\:mm\:ss");

    protected override async Task OnParametersSetAsync()
    {
        _questions = await Assessment.GetQuestionsAsync(Kind);
        _startedAt = DateTimeOffset.UtcNow;
        _remainingSeconds = Math.Max(0, TimeLimitMinutes * 60);
        if (TimeLimitMinutes > 0)
        {
            StartTimer();
        }
        _loading = false;
    }

    private void Select(int index) => _answers[CurrentQuestion.Id] = index;
    private void Next()
    {
        _current = Math.Min(_current + 1, _questions.Count - 1);
        ResetAudio();
    }

    private void Previous()
    {
        _current = Math.Max(0, _current - 1);
        ResetAudio();
    }

    private string SelectedClass(int index) =>
        _answers.TryGetValue(CurrentQuestion.Id, out var selected) && selected == index ? "selected" : "";
    private string OptionLabel(int index) =>
        IsListeningQuestion
        && ToeicListeningPresentation.HideOptionText(CurrentQuestion)
            ? $"Choice {(char)('A' + index)}"
            : CurrentQuestion.Options[index];

    private async Task PlayListeningAudioAsync()
    {
        _audioError = null;
        var audioText = ToeicListeningPresentation.BuildAudioText(CurrentQuestion);
        if (!ToeicAudio.CanServe(CurrentQuestion))
        {
            _audioError = "Using the browser voice. Configure AI__ApiKey for cached high-quality reference audio.";
            await JS.InvokeVoidAsync("englishMaster.speak", audioText, 1);
            return;
        }

        if (_audioQuestionId == CurrentQuestion.Id && _audioDataUrl is not null)
        {
            return;
        }

        _loadingAudio = true;
        try
        {
            var audio = await ToeicAudio.GetAsync(
                await CurrentUser.GetRequiredUserIdAsync(),
                CurrentQuestion);
            _audioQuestionId = CurrentQuestion.Id;
            _audioDataUrl =
                $"data:{audio.ContentType};base64,{Convert.ToBase64String(audio.Bytes)}";
            _audioDisclosure = audio.Disclosure;
        }
        catch (Exception)
        {
            _audioError = "Reference audio was unavailable; using the browser voice.";
            await JS.InvokeVoidAsync("englishMaster.speak", audioText, 1);
        }
        finally
        {
            _loadingAudio = false;
        }
    }

    private void ResetAudio()
    {
        _audioQuestionId = null;
        _audioDataUrl = null;
        _audioDisclosure = null;
        _audioError = null;
    }

    private async Task SubmitAsync()
    {
        if (_submitting || _result is not null)
        {
            return;
        }
        _submitting = true;
        _timerCancellation?.Cancel();
        var userId = await CurrentUser.GetRequiredUserIdAsync();
        var seconds = (int)(DateTimeOffset.UtcNow - _startedAt).TotalSeconds;
        _result = await Assessment.SubmitAsync(userId, Kind, _answers, seconds);
        _submitting = false;
    }

    private void StartTimer()
    {
        _timerCancellation?.Cancel();
        _timerCancellation?.Dispose();
        _timerCancellation = new CancellationTokenSource();
        _ = RunTimerAsync(_timerCancellation.Token);
    }

    private async Task RunTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _remainingSeconds = Math.Max(
                    0,
                    TimeLimitMinutes * 60 - (int)(DateTimeOffset.UtcNow - _startedAt).TotalSeconds);
                await InvokeAsync(StateHasChanged);
                if (_remainingSeconds == 0)
                {
                    await InvokeAsync(SubmitAsync);
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _timerCancellation?.Cancel();
        _timerCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}
