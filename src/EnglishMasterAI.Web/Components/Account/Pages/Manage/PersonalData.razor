@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>ข้อมูลส่วนบุคคล | EnglishMaster AI</PageTitle>

<StatusMessage />
<h3>ข้อมูลส่วนบุคคล</h3>

<div class="row">
    <div class="col-md-6">
        <p>บัญชีประกอบด้วยข้อมูลระบุตัวตน ความคืบหน้า ผลประเมิน งานเขียน และ transcript การพูด คุณสามารถดาวน์โหลดหรือลบข้อมูลทั้งหมดได้จากหน้านี้</p>
        <p>ไฟล์เสียงดิบประมวลผลในหน่วยความจำและไม่ถูกเก็บไว้โดยค่าเริ่มต้น</p>
        <p>
            <strong>การลบข้อมูลจะปิดบัญชีอย่างถาวรและไม่สามารถกู้คืนได้</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">ดาวน์โหลดข้อมูล</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">ลบบัญชีและข้อมูล</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
