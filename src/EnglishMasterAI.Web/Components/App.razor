<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["EnglishMasterAI.Web.styles.css"]" />
    <ImportMap AdditionalAttributes="ImportMapAttributes" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <meta name="theme-color" content="#102a2a" />
    <HeadOutlet />
</head>

<body>
    @* No render mode here on purpose. Setting one on Routes makes it apply to
       every page and blocks pages from choosing their own, which forced every
       interactive page to prerender and then fetch its data a second time.
       Pages that need interactivity now declare it themselves; the rest render
       statically once. *@
    <Routes />
    <script src="@Assets["learning.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IReadOnlyDictionary<string, object> ImportMapAttributes =>
        new Dictionary<string, object>
        {
            ["nonce"] = Infrastructure.CspNonce.Get(HttpContext)
        };
}
