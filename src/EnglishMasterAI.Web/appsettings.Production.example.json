{
  "ConnectionStrings": {
    "PostgreSqlConnection": "Host=postgres;Port=5432;Database=englishmaster;Username=englishmaster;Password=SET_WITH_SECRET_MANAGER",
    "Redis": "redis:6379,abortConnect=false",
    "AudioBlobStorage": "SET_WITH_SECRET_MANAGER"
  },
  "Database": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "PostgreSqlConnection",
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false,
    "AllowSqliteInProduction": false
  },
  "AllowedHosts": "english.example.com",
  "DataProtection": {
    "KeysPath": "/var/lib/englishmaster/keys"
  },
  "AudioStorage": {
    "Provider": "AzureBlob",
    "ConnectionStringName": "AudioBlobStorage",
    "ContainerName": "englishmaster-audio",
    "ObjectPrefix": "reference-audio",
    "CreateContainerIfMissing": false,
    "CdnBaseUrl": "https://media.english.example.com/"
  },
  "MultiInstance": {
    "Enabled": true,
    "RedisConnectionStringName": "Redis",
    "UseDistributedRateLimiting": true,
    "UseSharedDataProtectionKeys": true,
    "DataProtectionKeyName": "EnglishMasterAI-DataProtection-Keys",
    "RateLimitKeyPrefix": "englishmaster:ratelimit"
  },
  "ToeicMedia": {
    "ManifestPath": "content/toeic-media/manifest.json",
    "RequireApprovedHumanAudio": true,
    "AllowAiGeneratedFallback": false
  },
  "SeedAdmin": {
    "Enabled": false
  },
  "Security": {
    "RequireConfirmedAccount": true,
    "ApiRequestsPerMinute": 60,
    "AiRequestsPerMinute": 10,
    "LoginRequestsPerMinute": 10
  },
  "Proxy": {
    "Enabled": true,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": [
      "SET_TO_INGRESS_CIDR"
    ]
  },
  "Legal": {
    "OperatorName": "SET_TO_REGISTERED_OPERATOR_NAME",
    "PrivacyContactEmail": "privacy@example.invalid",
    "BackupRetentionDays": 30,
    "TelemetryRetentionDays": 30
  },
  "AI": {
    "Enabled": true,
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "",
    "FeedbackModel": "gpt-5.6-luna",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "SpeechModel": "tts-1-hd",
    "SpeechVoice": "alloy",
    "ReferenceAudioCachePath": "/var/lib/englishmaster/audio-cache",
    "InputTokenUsdPerMillion": 0,
    "OutputTokenUsdPerMillion": 0,
    "SpeechUsdPerMillionCharacters": 0,
    "TranscriptionUsdPerMinute": 0
  },
  "Pronunciation": {
    "Enabled": true,
    "Provider": "AzureSpeech",
    "AzureSpeechKey": "",
    "AzureSpeechRegion": "",
    "Locale": "en-US",
    "MaxAudioSeconds": 30
  },
  "Observability": {
    "ServiceName": "EnglishMasterAI",
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnableConsoleExporter": false
  },
  "Alerting": {
    "Enabled": true,
    "WebhookUrl": "",
    "CooldownMinutes": 15
  },
  "Email": {
    "Enabled": true,
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@english.example.com",
    "FromName": "EnglishMaster AI"
  }
}
